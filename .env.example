PORT=3000
SITE_URL=https://www.your-domain.com
ADMIN_USER=admin
ADMIN_PASS=change-this-long-password
# Optional email notification for each enquiry
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_TO=
# Where enquiries are stored (mount a persistent volume here)
DATA_DIR=./data
# Send an automatic acknowledgement to people who submit a form (needs SMTP above)
AUTOREPLY=false
